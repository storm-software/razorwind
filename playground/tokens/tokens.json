{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Brand and surface colors for playground generator runs.",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.051, 0.051, 0.071],
        "hex": "#0d0d12"
      },
      "$description": "Default canvas background"
    },
    "fg": {
      "$value": "#e8e8ed",
      "$description": "Default foreground / body text"
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.4, 0.8],
        "hex": "#0066cc"
      },
      "$description": "Brand primary"
    },
    "secondary": {
      "$value": "#663399"
    },
    "accent": {
      "$value": "{color.primary}"
    },
    "muted": {
      "$value": "#6a6a7a"
    },
    "border": {
      "$value": "#2a2a38"
    },
    "danger": {
      "$value": "#e5484d"
    },
    "success": {
      "$value": "#3dd68c"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": { "value": 0.25, "unit": "rem" } },
    "sm": { "$value": { "value": 0.5, "unit": "rem" } },
    "md": { "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$value": { "value": 1.5, "unit": "rem" } },
    "xl": { "$value": { "value": 2.5, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "DEFAULT": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter", "system-ui", "sans-serif"]
    },
    "mono": {
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"]
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "bold": { "$value": 700 }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 1, "unit": "rem" },
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "px" }
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 1.5, "unit": "rem" },
        "fontWeight": "{fontWeight.bold}",
        "lineHeight": 1.25,
        "letterSpacing": { "value": -0.02, "unit": "rem" }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.4, 0, 0.2, 1] }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 }
  },
  "shadow": {
    "$type": "shadow",
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.35,
          "hex": "#000000"
        },
        "offsetX": { "value": 0, "unit": "rem" },
        "offsetY": { "value": 0.5, "unit": "rem" },
        "blur": { "value": 1.5, "unit": "rem" },
        "spread": { "value": 0, "unit": "rem" }
      }
    }
  }
}
