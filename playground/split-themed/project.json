{
  "name": "playground-split-themed",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "playground/split-themed",
  "tags": ["type:playground", "platform:node"],
  "implicitDependencies": [
    "core",
    "color-variants",
    "css",
    "design-md",
    "docgen",
    "shiki",
    "storybook",
    "style-dictionary",
    "tamagui",
    "tailwindcss"
  ],
  "targets": {
    "generate": {
      "cache": false,
      "inputs": [
        "{projectRoot}/razorwind.config.ts",
        "{projectRoot}/tokens/**/*.json",
        "{projectRoot}/generate.mjs"
      ],
      "outputs": ["{projectRoot}/generated"],
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "options": {
        "command": "node ./generate.mjs",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "node ./generate.mjs"
        },
        "development": {
          "command": "node ./generate.mjs --development"
        }
      }
    }
  }
}
