{
  "name": "nx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nx/src",
  "targets": {
    "build-base": {
      "cache": false,
      "inputs": [
        "typescript",
        "^production"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "executor": "@powerlines/nx:build",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "configFile": "packages/nx/powerlines.base.ts",
        "outputPath": "packages/nx/dist"
      }
    },
    "build-plugin": {
      "cache": false,
      "inputs": [
        "typescript",
        "^production"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "executor": "@powerlines/nx:build",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "configFile": "packages/nx/powerlines.plugin.ts",
        "outputPath": "packages/nx/dist"
      }
    },
    "build": {
      "cache": false,
      "inputs": [
        "typescript",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{workspaceRoot}/dist/packages/nx"
      ],
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-base",
        "build-plugin"
      ],
      "options": {
        "commands": [
          "pnpm copyfiles LICENSE dist/packages/nx",
          "pnpm copyfiles --up=2 \"packages/nx/*.md\" packages/nx/executors.json packages/nx/generators.json packages/nx/package.json dist/packages/nx",
          "pnpm copyfiles --up=3 \"packages/nx/src/executors/*/schema.json\" \"packages/nx/src/executors/*/schema.d.ts\" \"packages/nx/src/generators/*/schema.json\" \"packages/nx/src/generators/*/schema.d.ts\" packages/nx/dist",
          "pnpm copyfiles --up=4 \"packages/nx/src/**/*.md\" dist/packages/nx/docs/api"
        ],
        "parallel": false
      }
    },
    "nx-release-publish": {
      "executor": "@storm-software/workspace-tools:npm-publish",
      "dependsOn": [
        "build",
        "prepare-publish-manifest",
        "^nx-release-publish"
      ]
    }
  },
  "tags": [
    "platform:node"
  ]
}
