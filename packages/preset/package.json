{
  "name": "@razorwind/preset",
  "version": "0.0.3",
  "type": "module",
  "description": "Compose Razorwind theme plugins around one shared token-to-theme mapping.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/razorwind.git",
    "directory": "packages/preset"
  },
  "homepage": "https://stormsoftware.com",
  "bugs": {
    "url": "https://stormsoftware.com/support",
    "email": "support@stormsoftware.com"
  },
  "author": {
    "name": "Storm Software",
    "email": "contact@stormsoftware.com",
    "url": "https://stormsoftware.com"
  },
  "license": "Apache-2.0",
  "private": false,
  "files": ["dist"],
  "keywords": ["razorwind", "design-tokens", "dtcg", "theme", "preset"],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "dist/index.d.mts",
  "dependencies": {
    "@razorwind/chrome": "workspace:*",
    "@razorwind/core": "workspace:*",
    "@razorwind/cursor": "workspace:*",
    "@razorwind/ghostty": "workspace:*",
    "@razorwind/notepad-plus-plus": "workspace:*",
    "@razorwind/sandpack": "workspace:*",
    "@razorwind/shiki": "workspace:*",
    "@razorwind/storybook": "workspace:*",
    "@razorwind/thunderbird": "workspace:*",
    "@razorwind/vivaldi": "workspace:*",
    "@razorwind/vsce": "workspace:*",
    "@razorwind/zed": "workspace:*",
    "@razorwind/zsh": "workspace:*"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "@types/node": "catalog:",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
