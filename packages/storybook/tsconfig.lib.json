{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "outDir": "./out-tsc",
    "rootDir": ".",
    "paths": {
      "@razorwind/core": ["../core/src/index.ts"],
      "@razorwind/core/plugin": ["../core/src/plugin.ts"],
      "@razorwind/core/config": ["../core/src/config.ts"],
      "@razorwind/core/schema": ["../core/src/schema/index.ts"],
      "@razorwind/core/tokens": ["../core/src/lib/tokens/index.ts"],
      "@razorwind/core/utils": ["../core/src/utils/index.ts"]
    }
  },
  "references": [{ "path": "../core/tsconfig.lib.json" }],
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.cjs",
    "src/**/*.tsx",
    "src/**/*.jsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "types/*.d.ts",
    "package.json",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
