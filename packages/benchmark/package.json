{
  "name": "@razorwind/benchmark",
  "version": "0.0.15",
  "type": "module",
  "description": "Razorwind plugin for evaluating design-system effectiveness with AI coding agents.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/razorwind.git",
    "directory": "packages/benchmark"
  },
  "homepage": "https://stormsoftware.com",
  "license": "Apache-2.0",
  "private": false,
  "files": ["dist", "NOTICE", "README.md"],
  "keywords": [
    "razorwind",
    "design-system",
    "benchmark",
    "evaluation",
    "ai-agents",
    "open-design-system-bench"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "dist/index.d.mts",
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@power-plant/core": "catalog:",
    "@razorwind/core": "workspace:*",
    "react-docgen-typescript": "catalog:",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "@types/babel__traverse": "catalog:",
    "@types/node": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
