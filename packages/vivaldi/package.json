{
  "name": "@razorwind/vivaldi",
  "version": "0.0.8",
  "type": "module",
  "description": "Razorwind plugin that generates Vivaldi browser themes from design tokens.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/razorwind.git",
    "directory": "packages/vivaldi"
  },
  "homepage": "https://stormsoftware.com",
  "bugs": {
    "url": "https://stormsoftware.com/support",
    "email": "support@stormsoftware.com"
  },
  "author": {
    "name": "Storm Software",
    "email": "contact@stormsoftware.com",
    "url": "https://stormsoftware.com"
  },
  "license": "Apache-2.0",
  "private": false,
  "files": ["dist"],
  "keywords": [
    "vivaldi",
    "browser",
    "theme",
    "razorwind",
    "design-tokens",
    "dtcg",
    "storm-software"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./generate": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "dist/index.d.mts",
  "dependencies": {
    "@power-plant/core": "catalog:",
    "@power-plant/dtcg-schema": "catalog:",
    "@razorwind/core": "workspace:*"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "@types/node": "catalog:",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
